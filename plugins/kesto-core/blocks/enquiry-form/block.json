{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "kesto/enquiry-form",
	"title": "Enquiry form",
	"category": "widgets",
	"description": "Contact or wholesale enquiry form. Stores every submission under KESTO → Enquiries and emails the enquiry inbox.",
	"textdomain": "kesto",
	"attributes": {
		"type": { "type": "string", "default": "contact", "enum": [ "contact", "wholesale" ] }
	},
	"supports": { "html": false, "className": true },
	"editorScript": "file:./editor.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
